# specGraph PoC 환경변수 템플릿 (PPS-346)
#   cp deploy/.env.example deploy/.env  →  비밀값(토큰 · 비밀번호)만 채운다. deploy/.env 는 커밋하지 않는다.
# 모델 · 엔드포인트는 여기서만 바꾼다(코드 수정 없음 — AC2). 외부 LLM API 엔드포인트를 넣지 않는다.

# ---- product-docs (읽기 전용 토큰) -------------------------------------------
SPECGRAPH_REPO_URL=https://github.com/df-planning-dev/product-docs.git
SPECGRAPH_GIT_TOKEN=
SPECGRAPH_BRANCH_GLOB=draft/*
# 대상 디렉터리 이름만 쓴다(인덱싱 경로는 <프로젝트>/<대상 디렉터리>/… 아래 .md, 프로젝트 이름은 나열하지 않는다)
SPECGRAPH_INCLUDE_DIRS=prd,ui-ux-spec,tech-spec,qa
SPECGRAPH_POLL_INTERVAL_SECONDS=120
SPECGRAPH_GIT_TIMEOUT_SECONDS=120
SPECGRAPH_MAX_BLOCK_CHARS=1000
SPECGRAPH_LOG_FORMAT=kv

# ---- LLM (추출 · 보완 · 요약 병합용. 질의(MCP query)는 LLM 을 쓰지 않는다 — PPS-350) ------------
# 추출 LLM 바인딩. 허용값: ollama(기본, 로컬) · claude_code(구독 Claude Code 의 `claude -p`).
#   - claude_code 는 **구독 로그인된 사용자 PC 에서 호스트 실행(uv run specgraph-indexer)** 전용이다.
#     컨테이너 indexer · lightrag 는 docker-compose.yml 이 ollama 로 고정한다(컨테이너 안에는
#     로그인이 없다). 호스트에서 쓰려면 .env 를 바꾸지 말고 셸에서 덮어쓴다(runbook §9):
#       export LLM_BINDING=claude_code LLM_MODEL=<Claude Code 모델 별칭 또는 ID>
#   - claude_code 일 때: LLM_MODEL 은 `claude --model` 에 그대로 들어가는 값(아래 qwen3:8b 는
#     컨테이너용이라 반드시 덮어써야 한다). LLM_BINDING_HOST · OLLAMA_LLM_NUM_CTX 는 무시된다.
#     LLM_TIMEOUT 은 `claude -p` 1회 한도(초), MAX_ASYNC 는 동시에 뜨는 claude 프로세스 수다.
#     API 키 · Bedrock 등 과금 경로는 쓰지 않는다 — 자식 claude 프로세스 env 에서 ANTHROPIC_* ·
#     CLAUDE_CODE_USE_* · AWS_BEARER_TOKEN_BEDROCK · CLAUDECODE 와 이 파일의 SPECGRAPH_* · POSTGRES_*
#     가 제거된다. 자식 프로세스는 CLAUDE_CODE_OAUTH_TOKEN 을 읽으므로(제거하지 않음) 셸에 있다면
#     반드시 운영자 본인 토큰이어야 한다.
LLM_BINDING=ollama
# 컨테이너 Ollama(기본, CPU 추론, Qwen3-8B Apache-2.0, non-thinking). 호스트 네이티브 Ollama(Metal)로
# 바꾸려면 LLM_BINDING_HOST=http://host.docker.internal:11434   (결정 D1, AC12 측정용)
LLM_MODEL=qwen3:8b
# ollama 바인딩에서만 쓴다.
LLM_BINDING_HOST=http://ollama:11434
OLLAMA_LLM_THINK=false
# LLM 호출 하나의 타임아웃(초). ollama: HTTP 읽기 한도는 이 값, LightRAG 워커 한도는 이 값의 2배다.
# claude_code: `claude -p` 프로세스 1회 한도(넘기면 프로세스 그룹을 종료하고 그 챕터는 실패).
# 호스트 GPU 5.3 tok/s 에서 Ollama 호출 하나가 1,185초였다. 느린 환경이면 늘린다.
# 주의: docker-compose.yml 이 기본값 없이 참조한다 — 기존 .env 에 이 줄이 없으면 빈 값으로
# indexer 가 기동하지 못한다(PPS-349).
LLM_TIMEOUT=1800
# Ollama 요청의 컨텍스트 크기(num_ctx, 토큰) — ollama 바인딩에서만. 서버 기본 4096 은 추출 출력이
# 길면 창이 차서 지시문이 잘린다. 호스트 Ollama 는 OLLAMA_CONTEXT_LENGTH 를 같은 값 이상으로
# 띄운다(runbook §2). OLLAMA_NUM_PARALLEL 이 1 이 아니면 슬롯 수만큼 KV 캐시 메모리가 곱해진다.
OLLAMA_LLM_NUM_CTX=16384
# LightRAG 동시 LLM 호출 수. claude_code 면 동시에 뜨는 claude 프로세스 수(구독 한도 실측 뒤 조정).
MAX_ASYNC=2

# ---- 임베딩 (Ollama BGE-M3, MIT) -------------------------------------------------
# KURE-v1 로 바꾸려면(라이선스 확인 후): EMBEDDING_BINDING=openai,
#   EMBEDDING_MODEL=nlpai-lab/KURE-v1, EMBEDDING_BINDING_HOST=http://rerank:7997,
#   INFINITY_EXTRA_ARGS=--model-id nlpai-lab/KURE-v1  (차원 1024 동일, 전환 시 재색인 필요)
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=http://ollama:11434

# ---- 리랭커 (Infinity, BAAI/bge-reranker-v2-m3 Apache-2.0) -----------------------
# RERANK_BINDING_HOST 는 LightRAG 규약대로 rerank 엔드포인트 전체 URL 이다.
RERANK_BINDING=cohere
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST=http://rerank:7997/rerank
INFINITY_EXTRA_ARGS=

# ---- LightRAG ------------------------------------------------------------------
SUMMARY_LANGUAGE=Korean
# 청크 토큰 한도. 인덱서는 이 값으로 표 블록을 다시 나눈다(AC10). 서버 · 인덱서가 같은 값을 쓴다.
CHUNK_SIZE=1200
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# ---- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=specgraph
# 반드시 채운다(기본값 없음 — 비어 있으면 compose 가 기동을 거부한다). MCP 실행 셸에도 export 한다.
POSTGRES_PASSWORD=
POSTGRES_DATABASE=specgraph
# 호스트에서(MCP 서버 · --once 실행) 접속할 때의 주소. 컨테이너 안에서는 compose 가 postgres 로 덮어쓴다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Ollama 컨테이너 -------------------------------------------------------------
OLLAMA_PULL_MODELS="qwen3:8b bge-m3"
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m

# ---- 이미지 (arm64 지원 태그로 고정) -----------------------------------------------
OLLAMA_IMAGE=ollama/ollama:0.35.0
INFINITY_IMAGE=michaelf34/infinity:0.0.75
# uv.lock 의 lightrag-hku 버전과 맞춘다(같은 PostgreSQL 스키마 공유).
LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag:v1.5.7

# ---- 호스트 포트 (모두 127.0.0.1 바인딩) --------------------------------------------
POSTGRES_HOST_PORT=5432
OLLAMA_HOST_PORT=11434
RERANK_HOST_PORT=7997
LIGHTRAG_HOST_PORT=9621
